{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cutaway",
  "mainBinaryName": "Cutaway",
  "version": "0.1.0",
  "identifier": "com.cutaway.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cutaway",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#0B0D12",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "cutaway"
        ],
        "name": "Cutaway Episode",
        "role": "Editor"
      },
      {
        "ext": [
          "cutawayshow"
        ],
        "name": "Cutaway Show",
        "role": "Editor"
      }
    ],
    "copyright": "© 2026 Robert Sladeczek. All rights reserved.",
    "publisher": "Robert Sladeczek"
  }
}
